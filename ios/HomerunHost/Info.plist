<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- What appears under the icon. CFBundleName below stays $(PRODUCT_NAME)
	     so the bundle and executable keep the space-free `Homerun` name. -->
	<key>CFBundleDisplayName</key>
	<string>Homerun Go</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- The backend this build talks to — Android's `-PapiUrl` equivalent.
	     Defaulted in project.yml and overridable per build:

	       xcodebuild … HOMERUN_API_URL=https://api.fractalnetworks.co

	     Read by `HostStore.apiURL` only when the page has not stored one, so a
	     backend picked inside the app still outranks the build. -->
	<key>HomerunAPIURL</key>
	<string>$(HOMERUN_API_URL)</string>

	<!-- Over-the-air UI bundles, on unless a build says otherwise:

	       xcodebuild … HOMERUN_OTA_UPDATES=0

	     Read by `Capabilities.otaUpdates`, which treats a *missing* key as on:
	     absent means an older generated project, and a build that silently
	     stopped updating is far harder to notice than one that never started. -->
	<key>HomerunOTAUpdates</key>
	<string>$(HOMERUN_OTA_UPDATES)</string>

	<!-- Auth returns through homerun:// (email OTP / magic link). Universal
	     Links are added alongside this at M2, once a signing team exists. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>homerun</string>
			</array>
		</dict>
	</array>

	<!-- Brand blue rather than the default system background, which is white
	     on a light device and black on a dark one — either way a flash of a
	     colour the app never shows again, before the bundle's own splash
	     appears. The colour is the one thing the launch screen can be given
	     without a storyboard, and it has to come from an asset catalog:
	     Assets.xcassets/LaunchBackground.colorset. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- Portrait only. Every screen in the bundle is a single column against a
	     bottom tab bar and none of them has a landscape design, so rotating
	     gave a stretched phone layout rather than a wider one. Upside-down is
	     left out as well, which is the iPhone convention. TARGETED_DEVICE_FAMILY
	     is "1", so there is no ~ipad variant to keep in step with this. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- Shown when the app first reports the LAN address friends connect to. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Homerun Go shows your phone's Wi-Fi address so friends on the same network can join your Minecraft server.</string>

	<!-- Lets the dev loop point at http://localhost:3000 and permits plain-HTTP
	     LAN reachability checks. Public traffic still requires TLS.

	     It is also what lets the UI reach this device's own console: the device
	     websocket binds a plaintext listener on 127.0.0.1 and the page dials
	     ws://localhost:<port> for the phone it is running on, reserving
	     wss://<fqdn> for other people's. Nothing between those two ends is on a
	     network to encrypt against. Android says the same thing in
	     res/xml/network_security_config.xml. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- No UIBackgroundModes: iOS cannot host a server in the background, and
	     the app says so rather than pretending otherwise. Declaring a mode we
	     cannot honour is also an App Review rejection. -->
</dict>
</plist>
