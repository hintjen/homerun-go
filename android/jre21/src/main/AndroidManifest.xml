<?xml version="1.0" encoding="utf-8"?>
<!--
  Currently install-time, so it arrives with the app; see the delivery
  element below for why, and what it costs. Built for on-demand, where
  `JavaRuntime.ensure` asks for it the first time a server selects Java 21.

  `dist:title` is shown by Play in its own download confirmation, so it is
  written for a player rather than a log — the same rule the bridge's error
  messages follow.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:dist="http://schemas.android.com/apk/distribution">

    <dist:module
        dist:instant="false"
        dist:title="@string/jre21_module_title">
        <dist:delivery>
            <!--
              install-time, not on-demand, until the Play listing clears review.

              An unreviewed app has no listing a user can be sent to acquire it
              from, so Play cannot run the confirmation that on-demand delivery
              falls back on for an unowned app, and refuses every module with
              APP_NOT_OWNED (-15) instead. With no JVM in the base APK that is
              not a degraded experience, it is no Java server starting at all.

              Flipping back is this one element. Everything else — the module,
              the staging, SplitCompat, the fetch — is already built for it, and
              the base install drops from ~167 MB to ~54 MB when it goes back.
              See docs/android-server-backend.md.
            -->
            <dist:install-time />
        </dist:delivery>
        <dist:fusing dist:include="true" />
    </dist:module>

    <!--
      The module is a directory of assets and nothing else. Without this,
      `packageReleaseBundle` fails: "Module 'jre21' has no dex files but the
      attribute 'hasCode' is not set to false".
    -->
    <application android:hasCode="false" />
</manifest>
