<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The product name, as the shared UI's own header renders it. Used for the
      launcher label, the notification header, and the title of the hosting
      notification before a server name is known — so it has to match what the
      user sees inside the app, which is "Homerun Go" and not "Homerun".
    -->
    <string name="app_name">Homerun Go</string>

    <!--
      The hosting notification. Written for a player glancing at a lock screen,
      not for a log — the same rule the bridge's error messages follow.
    -->
    <string name="alerts_channel_name">Alerts</string>
    <string name="hosting_channel_name">Server hosting</string>
    <string name="hosting_channel_description">Shown while this phone is running a
        Minecraft server, or finishing a backup. Turning it off will not stop the
        server, but you will lose the Stop button.</string>
    <string name="hosting_stop">Stop</string>
    <string name="hosting_starting">Starting…</string>
    <string name="hosting_stopping">Stopping — saving the world…</string>
    <!-- A run that has ended. Shown only for the moment between the state
         arriving and the service standing down, which removes the
         notification; a terminal state used to fall through to "Starting…". -->
    <string name="hosting_stopped">Stopped</string>
    <string name="hosting_running">Your server is online</string>
    <string name="hosting_running_empty">Online · nobody playing yet</string>
    <string name="hosting_running_one">Online · 1 player</string>
    <string name="hosting_running_many">Online · %1$d players</string>
    <string name="hosting_backing_up">Backing up your world — don\'t close Homerun Go</string>

    <!--
      Shown by Play itself, in the confirmation it raises before downloading
      the Java 21 module over mobile data. The player has just pressed start
      on a modded server, so it names what they are waiting for rather than
      the module.
    -->
    <string name="jre17_module_title">Java 17 runtime</string>
    <string name="jre21_module_title">Java 21 runtime</string>
    <string name="jre25_module_title">Java 25 runtime</string>
</resources>
