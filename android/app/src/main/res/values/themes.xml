<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Light-mode variant. The parent matters beyond appearance: WebView reads
      the theme's `isLightTheme` to answer `prefers-color-scheme`, which is
      what makes the shared UI's `system` setting follow the device at all.

      The bars start on the launch blue and are recoloured at runtime once the
      page reports the colour it is painted — see MainActivity.applyChrome.
      Everything here is the pre-page state.
    -->
    <style name="Theme.Homerun" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@color/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
        <!-- White clock and battery: the launch blue is a dark background. -->
        <item name="android:windowLightStatusBar">false</item>

        <!--
          The Android 12+ splash: the same blue and no icon, so the only mark
          the player sees arriving is the bundle's animated one. See
          drawable/splash_icon_none.xml for why the icon is a transparent
          drawable rather than an absent attribute.

          These live here rather than in values-v31 on purpose. `night` beats
          `version` in resource qualifier precedence, so a values-v31 would be
          passed over on a dark-mode phone and the split would have to be four
          files to work. An older platform never looks up an attribute id it
          does not know, so declaring them unconditionally is safe — tools:
          targetApi is only there to say so to lint.
        -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_icon_none</item>
    </style>
</resources>
