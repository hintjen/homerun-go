<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Same window as values/themes.xml — only the parent differs, and only
         because WebView derives `prefers-color-scheme` from the theme's
         `isLightTheme`. The colours are identical on purpose: what is on
         screen before the page paints is the launch blue either way.

         The splash items are repeated rather than inherited because this file
         replaces the light one wholesale on a dark-mode device. Keep the two
         in step. -->
    <style name="Theme.Homerun" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@color/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_icon_none</item>
    </style>
</resources>
