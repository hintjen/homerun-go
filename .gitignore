# Rust
/rust/**/target/
**/*.rs.bk

# The shared UI bundle, fetched or built at package time — never committed
/ios/HomerunHost/web/
/android/app/src/main/assets/web/
# The Java runtimes, staged by `npm run jre:android` — 160+ MB each, one
# directory per major (`jre-21`, `jre-25`), never committed
/android/app/src/main/assets/jre-*/
/android/app/src/main/assets/jre/
/.jre-cache/

# Go
# generated by build-wireproxy.js; points at a checkout outside this repo
/go/wireproxy-ios/go.work
/go/wireproxy-ios/go.work.sum

# iOS
# libhomerun_pumpkin_ffi.a and WireproxyIOS.xcframework, staged by the build scripts
/ios/HomerunHost/lib/
# generated by xcodegen from project.yml
/ios/*.xcodeproj/
/ios/build/
/ios/DerivedData/
xcuserdata/
*.xcuserstate
/ios/Pods/

# Android
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/.idea/
*.iml
/android/app/src/main/jniLibs/
# The upload signing key and the passwords for it. CI writes keystore.properties
# from a secret; a committed one would let anyone publish as this app for ever,
# and Play will not reissue the key.
*.jks
*.keystore
keystore.properties

# Node (tooling only)
node_modules/

# Env / local
.env
.env.local
.ready

# OS
.DS_Store
Thumbs.db

# Python bytecode from scripts/ (stage-jre.py is importable for its ELF checks).
__pycache__/

# Push credentials. Two of these are private keys and none of them belong in
# git: the Firebase service-account JSON signs sends *as the backend*, and the
# APNs .p8 can push to every app in the team and cannot be re-downloaded from
# Apple. Same rule as the upload keystore above.
#
# google-services.json / GoogleService-Info.plist are not secret by Google's
# own guidance, but they are per-environment build inputs — staging in a
# production build is a real user's phone getting test data — so they are
# staged like every other build input rather than committed.
*.p8
*firebase-adminsdk*.json
google-services.json
*-google-services.json
GoogleService-Info.plist
*-GoogleService-Info.plist
