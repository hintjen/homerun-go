# Rust
/rust/**/target/
**/*.rs.bk

# The shared UI bundle, fetched or built at package time — never committed
/ios/HomerunHost/web/
/android/app/src/main/assets/web/
# The Java runtime, staged by `npm run jre:android` — 100+ MB, never committed
/android/app/src/main/assets/jre/
/.jre-cache/

# Go
# generated by build-wireproxy.js; points at a checkout outside this repo
/go/wireproxy-ios/go.work
/go/wireproxy-ios/go.work.sum

# iOS
# libhomerun_pumpkin_ffi.a and WireproxyIOS.xcframework, staged by the build scripts
/ios/HomerunHost/lib/
# generated by xcodegen from project.yml
/ios/*.xcodeproj/
/ios/build/
/ios/DerivedData/
xcuserdata/
*.xcuserstate
/ios/Pods/

# Android
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/.idea/
*.iml
/android/app/src/main/jniLibs/

# Node (tooling only)
node_modules/

# Env / local
.env
.env.local
.ready

# OS
.DS_Store
Thumbs.db
