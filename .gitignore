# Rust
/rust/**/target/
**/*.rs.bk

# The shared UI bundle, fetched or built at package time — never committed
/ios/HomerunHost/web/
/android/app/src/main/assets/web/
# The Java runtime, staged by `npm run jre:android` — 100+ MB, never committed
/android/app/src/main/assets/jre/
/.jre-cache/

# iOS
/ios/*.xcodeproj/          # generated by xcodegen from project.yml
/ios/build/
/ios/DerivedData/
xcuserdata/
*.xcuserstate
/ios/Pods/

# Android
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/.idea/
*.iml
/android/app/src/main/jniLibs/

# Node (tooling only)
node_modules/

# Env / local
.env
.env.local
.ready

# OS
.DS_Store
Thumbs.db
