{
  "$id": "https://gethomerun.app/schemas/game.v0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One hostable game. Generated from homerun-core::engine::descriptor -- those types are the source of truth. Unknown properties are allowed on purpose: a descriptor written for a newer Homerun must degrade rather than fail.",
  "properties": {
    "catalog": {
      "properties": {
        "accent": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "type": "string"
        },
        "art": {
          "type": "string"
        },
        "blurb": {
          "type": "string"
        },
        "listed": {
          "description": "false when Homerun no longer offers new servers of this game. Existing servers keep working. Absent means listed. The runner ignores it.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "client": {
      "properties": {
        "joinUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "srv": {
          "description": "Set only when the game's client resolves SRV records.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "config": {
      "items": {
        "properties": {
          "file": {
            "type": "string"
          },
          "format": {
            "enum": [
              "properties",
              "ini",
              "json",
              "toml",
              "xml"
            ]
          },
          "keys": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          }
        },
        "required": [
          "file"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "console": {
      "properties": {
        "rcon": {
          "properties": {
            "port": {
              "description": "The name of a declared port, not a number.",
              "type": "string"
            },
            "protocol": {
              "enum": [
                "source",
                "webrcon"
              ]
            },
            "secret": {
              "description": "The name of a generated secret, never a literal.",
              "type": "string"
            }
          },
          "type": [
            "object",
            "null"
          ]
        },
        "via": {
          "enum": [
            "stdin",
            "rcon",
            "none"
          ]
        }
      },
      "type": "object"
    },
    "hosts": {
      "description": "Declared, never inferred. Every entry needs a matching `platforms` key.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "description": "Slug, and the games/<id>/ directory name.",
      "pattern": "^[a-z0-9-]+$",
      "type": "string"
    },
    "licence": {
      "properties": {
        "acceptVia": {
          "properties": {
            "contents": {
              "type": "string"
            },
            "file": {
              "type": "string"
            }
          },
          "required": [
            "file",
            "contents"
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "documents": {
          "items": {
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "url"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "limits": {
      "description": "Reserved for per-game ceilings. Nothing reads it yet."
    },
    "mods": {
      "properties": {
        "supported": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "name": {
      "type": "string"
    },
    "observe": {
      "properties": {
        "ping": {
          "enum": [
            "a2s",
            "tcp",
            "none"
          ]
        },
        "players": {
          "enum": [
            "a2s",
            "rcon",
            "log-regex",
            "none"
          ]
        },
        "playersCommand": {
          "type": [
            "string",
            "null"
          ]
        },
        "presence": {
          "properties": {
            "join": {
              "type": "string"
            },
            "leave": {
              "type": "string"
            }
          },
          "type": [
            "object",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "platforms": {
      "additionalProperties": {
        "properties": {
          "launch": {
            "properties": {
              "args": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "cwd": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cwdBase": {
                "default": "server",
                "description": "Directory cwd is relative to. Runtime is shared; keep saves under serverDir using an absolute data path or saves.mounts.",
                "enum": [
                  "server",
                  "runtime"
                ]
              },
              "env": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              "exe": {
                "description": "Relative to the runtime directory, without a platform suffix. Never templated.",
                "type": "string"
              }
            },
            "required": [
              "exe"
            ],
            "type": "object"
          },
          "runtime": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "source": {
                      "const": "tool"
                    }
                  },
                  "required": [
                    "source"
                  ]
                },
                "then": {
                  "required": [
                    "tool",
                    "args"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "source": {
                      "const": "direct"
                    }
                  },
                  "required": [
                    "source"
                  ]
                },
                "then": {
                  "required": [
                    "url",
                    "sha256"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "source": {
                      "const": "steamcmd"
                    }
                  },
                  "required": [
                    "source"
                  ]
                },
                "then": {
                  "required": [
                    "appId"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "source": {
                      "const": "vendor"
                    }
                  },
                  "required": [
                    "source"
                  ]
                },
                "then": {
                  "properties": {
                    "extract": {
                      "const": "zip"
                    },
                    "url": {
                      "pattern": "^https://",
                      "type": "string"
                    }
                  },
                  "required": [
                    "url",
                    "extract",
                    "versionSetting"
                  ]
                }
              }
            ],
            "properties": {
              "appId": {
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "args": {
                "description": "Tool only: the downloader's arguments. Only {output} and {credentials} are templated.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "buildId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "extract": {
                "enum": [
                  "none",
                  "zip",
                  null
                ]
              },
              "sha256": {
                "description": "Direct only. A vendor download is not pinned by digest.",
                "pattern": "^[0-9a-f]{64}$",
                "type": [
                  "string",
                  "null"
                ]
              },
              "signIn": {
                "description": "Tool only: substrings that identify the downloader's sign-in prompt.",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "size": {
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "sizeMb": {
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "source": {
                "enum": [
                  "direct",
                  "steamcmd",
                  "vendor",
                  "tool"
                ]
              },
              "stripComponents": {
                "description": "Leading path components dropped from every zip entry, for an archive nested under one top folder.",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "tool": {
                "description": "Tool only: the vendor's own downloader, pinned. Run with the person's own sign-in; never a mirror.",
                "properties": {
                  "exe": {
                    "type": "string"
                  },
                  "extract": {
                    "enum": [
                      "none",
                      "zip"
                    ]
                  },
                  "sha256": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  }
                },
                "required": [
                  "url",
                  "sha256",
                  "exe"
                ],
                "type": "object"
              },
              "url": {
                "description": "For vendor, an https pattern carrying {version} or {versionDigits} (the version without its dots) in its path, and no other placeholder.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "versionArgs": {
                "description": "Tool only: arguments that print the current version on the last line of output.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "versionSetting": {
                "description": "Vendor only: the string setting holding the player's choice of version. The host resolves it to one concrete version; the engine never lists them.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "description": "Keyed by host platform, e.g. win32-x64.",
      "type": "object"
    },
    "ports": {
      "items": {
        "properties": {
          "expose": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "port": {
            "description": "What the server binds AND the gateway dest port. Never the public port, which the allocator assigns.",
            "maximum": 65535,
            "minimum": 1,
            "type": "integer"
          },
          "proto": {
            "enum": [
              "tcp",
              "udp"
            ]
          },
          "service": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "port"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "ready": {
      "properties": {
        "marker": {
          "description": "A substring of one console line. Not a regex.",
          "type": "string"
        },
        "timeoutMs": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "requires": {
      "properties": {
        "cpuCores": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "diskMb": {
          "minimum": 0,
          "type": "integer"
        },
        "ramMb": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "saves": {
      "properties": {
        "excludes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mounts": {
          "items": {
            "properties": {
              "runtime": {
                "description": "Fixed directory path relative to the game's runtime. No traversal, aliases or placeholders.",
                "minLength": 1,
                "type": "string"
              },
              "server": {
                "description": "Real directory relative to this server's folder; saves physically live here.",
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "runtime",
              "server"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "schema": {
      "description": "Schema version. A higher number is refused.",
      "maximum": 0,
      "type": "integer"
    },
    "settings": {
      "items": {
        "properties": {
          "createOnly": {
            "description": "Chosen once, when the server is created: the game reads it only when its world is made. The API refuses a change afterwards. The runner ignores it.",
            "type": "boolean"
          },
          "default": {
            "description": "May be null, which drops the setting's flag from the launch line. A string default may contain {serverName} and no other placeholder."
          },
          "group": {
            "description": "A heading to show the setting under. The runner ignores it.",
            "type": [
              "string",
              "null"
            ]
          },
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "max": {
            "description": "Inclusive, and only meaningful for an int setting. Ignored on any other type.",
            "type": [
              "integer",
              "null"
            ]
          },
          "min": {
            "description": "Inclusive, and only meaningful for an int setting. Ignored on any other type.",
            "type": [
              "integer",
              "null"
            ]
          },
          "optionLabels": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "What each option is called on screen, keyed by the option. The option is still what is stored and sent. For the UI; the runner ignores it.",
            "type": "object"
          },
          "options": {
            "description": "A closed set of choices, for a string setting only. A non-empty list is the only way to say \"pick one of these\" -- there is no enum type. An empty list means the same as no list.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "optionsFrom": {
            "description": "Where the choices are read from at run time instead of options. Only \"versions\" today: the game's version list, for a vendor runtime's versionSetting. The runner ignores it.",
            "type": [
              "string",
              "null"
            ]
          },
          "secret": {
            "description": "A value the UI masks, such as a server password a player chooses. Not a host-generated {secret:<name>}. The runner ignores it.",
            "type": "boolean"
          },
          "showWhen": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "description": "Show the setting only while every named setting holds one of the listed values. Display only; one level deep. The runner ignores it.",
            "type": "object"
          },
          "type": {
            "enum": [
              "string",
              "int",
              "bool"
            ]
          }
        },
        "required": [
          "key",
          "type"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "stop": {
      "properties": {
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "graceMs": {
          "minimum": 0,
          "type": "integer"
        },
        "via": {
          "enum": [
            "console",
            "interrupt"
          ]
        }
      },
      "type": "object"
    }
  },
  "required": [
    "id",
    "name",
    "hosts"
  ],
  "title": "Homerun game descriptor",
  "type": "object"
}
