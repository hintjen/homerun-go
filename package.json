{
  "name": "homerun-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Build tooling for the Homerun iOS and Android hosts. The apps are built by Xcode and Gradle; this orchestrates the shared UI bundle and the Rust FFI they both need.",
  "license": "UNLICENSED",
  "scripts": {
    "doctor": "node scripts/doctor.js",
    "ui": "node scripts/build-ui.js",
    "ui:ios": "node scripts/build-ui.js ios",
    "ui:android": "node scripts/build-ui.js android",
    "jre:android": "python3 scripts/stage-jre.py arm64-v8a",
    "jre:android-x86_64": "python3 scripts/stage-jre.py x86_64",
    "jre:android-25": "python3 scripts/stage-jre.py arm64-v8a --java 25",
    "jre:android-x86_64-25": "python3 scripts/stage-jre.py x86_64 --java 25",
    "wireproxy:android": "node scripts/build-wireproxy.js android",
    "wireproxy:android-x86_64": "node scripts/build-wireproxy.js android-x86_64",
    "restic:android": "node scripts/build-restic.js android",
    "restic:android-x86_64": "node scripts/build-restic.js android-x86_64",
    "rust:host": "node scripts/build-rust.js host",
    "rust:ios": "node scripts/build-rust.js ios",
    "rust:ios-sim": "node scripts/build-rust.js ios-sim",
    "rust:android": "node scripts/build-rust.js android",
    "rust:android-x86_64": "node scripts/build-rust.js android-x86_64",
    "rust:java-launcher": "node scripts/build-rust.js java-launcher",
    "rust:java-launcher-x86_64": "node scripts/build-rust.js java-launcher-x86_64",
    "build:ios": "npm run ui:ios && npm run rust:ios",
    "build:android": "npm run ui:android && npm run rust:android && npm run wireproxy:android",
    "build:android:release": "npm run ui:android && npm run rust:android && npm run rust:java-launcher && npm run wireproxy:android && npm run restic:android && npm run jre:android",
    "android:build": "node scripts/android-app.js build",
    "android:install": "node scripts/android-app.js install",
    "android:run": "node scripts/android-app.js run",
    "android:emulator": "node scripts/android-app.js emulator",
    "android:logs": "node scripts/android-app.js logs",
    "test": "npm run test:core && npm run test:rust && npm run test:abi && npm run test:host-revision && npm run test:capabilities",
    "test:abi": "node scripts/check-abi.js",
    "test:host-revision": "node scripts/check-host-revision.js",
    "test:capabilities": "node scripts/check-capabilities.js",
    "test:core": "cargo test --manifest-path rust/homerun-core/Cargo.toml",
    "test:core:lint": "cargo fmt --manifest-path rust/homerun-core/Cargo.toml --check && cargo clippy --manifest-path rust/homerun-core/Cargo.toml --all-targets -- -D warnings",
    "test:rust": "cargo test --manifest-path rust/homerun-pumpkin-ffi/Cargo.toml --features process-engine",
    "sync-contract": "node scripts/sync-contract.js",
    "conformance:ios": "node shared/conformance/check-coverage.js ios ios/HomerunHost/BridgeRouter.swift",
    "conformance:android": "node shared/conformance/check-coverage.js android android/app/src/main/java/app/gethomerun/mobile/BridgeRouter.kt"
  },
  "dependencies": {
    "homerun-app-ui": "github:hintjen/homerun-app-ui#main"
  }
}
